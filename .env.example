# ==============================================================================
# HCM Lite — Environment Configuration Example (Saylani Hackathon 2026)
# Copy this file to '.env' before launching the project.
# ==============================================================================

# 1. Database Connection (Zero-dependency SQLite for instant local execution)
DATABASE_URL="file:./dev.db"

# 2. JWT Authentication Secret (Used by Jose to sign HTTP-only session cookies)
JWT_SECRET="saylani-hackathon-2026-hcm-lite-secret-key-32-chars-long"

# 3. Hosted LLM API Key (Optional)
# If provided, the AI Assistant calls Google Gemini 1.5 Flash for natural language responses.
# If left blank, HCM Lite's built-in intelligent synthesizer handles all queries,
# tools, and Roman Urdu offline with 100% functionality!
AI_API_KEY=""

# 4. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
